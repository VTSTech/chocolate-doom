+//
+// [CDVK] FOV slider
+//
+void M_ChangeFOV(int choice)
+{
+    switch(choice)
+    {
+      case 0:
+	if (fov > FOV_MIN)
+	    fov--;
+	break;
+      case 1:
+	if (fov < FOV_MAX)
+	    fov++;
+	break;
+    }
+
+    R_SetViewSize (screenblocks, detailLevel);
+}
+
 
 
 
