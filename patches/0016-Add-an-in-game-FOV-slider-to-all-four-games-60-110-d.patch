+//---------------------------------------------------------------------------
+//
+// PROC SCFov  [CDVK] FOV
+//
+//---------------------------------------------------------------------------
+
+static boolean SCFov(int option)
+{
+    if (option == RIGHT_DIR)
+    {
+        if (fov < FOV_MAX)
+        {
+            fov++;
+        }
+    }
+    else if (fov > FOV_MIN)
+    {
+        fov--;
+    }
+    R_SetViewSize(screenblocks, detailLevel);
+    return true;
+}
+
